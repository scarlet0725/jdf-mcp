{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Workers のランタイム型は `npm run cf-typegen` で worker-configuration.d.ts に生成する。テストは Node で動かす
    "types": ["node"]
  },
  "include": ["src", "test", "worker-configuration.d.ts"]
}
